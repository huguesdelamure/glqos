config glqos 'main'
	# dashboard port; listen address defaults to the LAN IP (network.lan.ipaddr)
	option port '8088'
	option listen ''
	# 5 Hz ping target used for RTT / loss / jitter
	option ping_target '8.8.8.8'
	# days of history kept in /data/glqos
	option retention_days '30'

# Used only by the optional glqos-simguard package
config simguard 'simguard'
	# no ping reply for this many seconds: data SIM considered down, standby SIM woken up
	option down_s '30'
	# data SIM healthy for this many seconds: standby SIM put back to sleep
	option calm_s '120'
	# periodic check that the standby SIM is still deregistered
	option check_s '60'
