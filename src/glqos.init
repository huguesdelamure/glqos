#!/bin/sh /etc/rc.common
# glqos: 1 Hz radio/IP collector, 5 Hz pinger and live dashboard (uhttpd).
START=99
USE_PROCD=1

start_service() {
	config_load glqos
	config_get port main port 8088
	config_get listen main listen ''
	# default: bind to the LAN address only
	[ -n "$listen" ] || listen=$(uci -q get network.lan.ipaddr)
	listen=${listen%%/*}

	procd_open_instance pinger
	procd_set_param command /bin/sh /etc/glqos/pinger.sh
	procd_set_param respawn 3600 5 0
	procd_close_instance

	procd_open_instance collect
	procd_set_param command /bin/sh /etc/glqos/collect.sh
	procd_set_param respawn 3600 5 0
	procd_close_instance

	procd_open_instance web
	procd_set_param command /usr/sbin/uhttpd -f -h /etc/glqos/www -x /cgi-bin -t 30 -p "${listen}:${port}"
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger glqos
}
